UPSTASH_REDIS_REST_TOKEN=

RESEND_API_KEY=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Notion OAuth (per-shop user-owned Shipments DB). Redirect must match integration settings.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://track-to-inventory-web.makiron19831014.workers.dev/auth/notion/callback
# 32 raw bytes, or base64 encoding of 32 bytes — encrypts Notion tokens in Upstash
TOKEN_ENCRYPTION_KEY=

# Inventory sync ledger authority (Redis legacy shadow): supabase | shadow | redis
# shadow = Supabase decides mutations; Redis claim simulated/mirrored for comparison
# redis  = Redis decides mutations; finalize mirrored to Supabase (do not enable until gates clear)
INVSYNC_LEDGER_MODE=supabase
D1_SHIPMENTS_MODE=off
# Stage L9.4: user-facing reads only. Invalid/unset values safely use Supabase.
D1_SHIPMENTS_READ_MODE=supabase
# Explicit write override. Unset preserves legacy D1_SHIPMENTS_MODE behavior.
D1_SHIPMENTS_WRITE_MODE=off

# D1 ledger mode (Stage L2+): off | shadow | primary
# shadow = compare/record only; never authorizes Shopify mutation
# primary = not enabled in L2 — keep off or shadow only
D1_LEDGER_MODE=off

# Upstash Redis remains for inventory sync ledger / Notion (not sessions).
# Shopify session authority is D1-fixed (SESSION_D1_MODE removed in L6.0).
