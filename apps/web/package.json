{
  "name": "@track-to-inventory/web",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "dev:cf": "wrangler dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "deploy:cf": "wrangler deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node ./server.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc",
    "d1:migrate:local": "wrangler d1 migrations apply track-to-inventory --local",
    "d1:migrate:remote": "wrangler d1 migrations apply track-to-inventory --remote",
    "d1:migrations:list": "wrangler d1 migrations list track-to-inventory --remote",
    "d1:schema:check": "node --experimental-strip-types scripts/d1-schema-check.mts",
    "test:d1": "npm run d1:migrate:local && npx tsx scripts/d1-l1-integration-tests.mts",
    "test:d1:l2": "npm run d1:migrate:local && npx tsx scripts/d1-l2-shadow-tests.mts",
    "test:d1:l71": "npm run d1:migrate:local && npx tsx scripts/d1-l71-parity-tests.mts",
    "test:d1:l81": "npm run d1:migrate:local && npx tsx scripts/d1-l81-notion-tests.mts",
    "test:d1:l91": "npm run d1:migrate:local && npx tsx scripts/d1-l91-shipments-compat-tests.mts",
    "test:d1:l91b": "npm run d1:migrate:local && npx tsx scripts/d1-l91b-idempotency-tests.mts",
    "test:d1:l93": "npm run d1:migrate:local && npx tsx scripts/d1-l93-shipments-shadow-tests.mts",
    "audit:shipments:l91b": "npx tsx --env-file=../../.env.local scripts/shipments-l91b-prod-audit.mts",
    "verify:d1:l92": "npx tsx --env-file=../../.env.local scripts/d1-l92-shipments-backfill-gate.mts --full --remote",
    "verify:d1:l72": "npx tsx --env-file=../../.env.local scripts/d1-l72-gate-verify.mts --remote",
    "verify:d1:l72:local": "npm run d1:migrate:local && npx tsx --env-file=../../.env.local scripts/d1-l72-gate-verify.mts --local",
    "seed:d1:ledger:dry": "npx tsx --env-file=.env.local scripts/seed-ledger-succeeded-to-d1.mts --dry-run --remote",
    "seed:d1:ledger:apply": "npx tsx --env-file=.env.local scripts/seed-ledger-succeeded-to-d1.mts --apply --remote",
    "audit:session:l40": "npx tsx --env-file=.env.local scripts/session-l40-audit.mts",
    "test:session:l40": "npm run d1:migrate:local && npx tsx scripts/session-l40-serializer-tests.mts",
    "test:session:l41": "npm run d1:migrate:local && npx tsx scripts/session-l41-seed-tests.mts",
    "test:session:l60": "npm run d1:migrate:local && npx tsx scripts/session-l60-d1-fixed-tests.mts",
    "test:usage:l51": "npm run d1:migrate:local && npx tsx scripts/usage-l51-quota-tests.mts",
    "test:usage:l55": "npm run d1:migrate:local && npx tsx scripts/usage-l55-gateway-tests.mts",
    "seed:d1:sessions:dry": "npx tsx --env-file=.env.local scripts/seed-sessions-to-d1.mts --dry-run --remote",
    "seed:d1:sessions:apply": "npx tsx --env-file=.env.local scripts/seed-sessions-to-d1.mts --apply --remote",
    "seed:d1:usage:l52:dry": "npx tsx --env-file=.env.local scripts/usage-l52-seed-reconcile.mts --dry-run --remote",
    "seed:d1:usage:l52:apply": "npx tsx --env-file=.env.local scripts/usage-l52-seed-reconcile.mts --apply --remote"
  },
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@react-router/fs-routes": "^7.14.0",
    "@react-router/node": "^7.14.0",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-app-react-router": "^1.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "@supabase/supabase-js": "^2.49.8",
    "@track-to-inventory/shared": "*",
    "@upstash/redis": "^1.35.0",
    "i18next": "^23.16.8",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-backend": "^3.0.2",
    "isbot": "^5.1.0",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.5.2",
    "react-router": "^7.14.0",
    "resend": "^4.6.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.0",
    "@graphql-codegen/cli": "^6.2.1",
    "@react-router/dev": "^7.14.0",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.15.31",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.4",
    "typescript": "^5.2.2",
    "vite": "^8.0.3",
    "wrangler": "^4.80.0"
  },
  "author": "mac"
}
