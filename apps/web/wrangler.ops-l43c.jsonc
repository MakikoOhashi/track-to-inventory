/**
 * OPS-ONLY Wrangler config for Stage L4.3c managed dual-write restore.
 *
 * NOT for `wrangler deploy` / day-to-day `wrangler dev`.
 * Isolates TTI_DB with remote:true so getPlatformProxy hits production D1.
 * database_id/name match apps/web/wrangler.jsonc (same production DB — not a new DB).
 *
 * Used only by: scripts/session-l43c-managed-restore.mts
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "track-to-inventory-web-ops-l43c",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-04-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SESSION_D1_MODE": "dual_write"
  },
  "d1_databases": [
    {
      "binding": "TTI_DB",
      "database_name": "track-to-inventory",
      "database_id": "28b7a4e7-3bb3-4f91-8d81-399e7cb928cb",
      "migrations_dir": "migrations",
      "remote": true
    }
  ]
}
